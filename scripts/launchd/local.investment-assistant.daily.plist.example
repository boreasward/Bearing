<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每日任务的 LaunchAgent 模板：把 __REPO__ 与 __HOME__ 替换成本机路径后
     复制到 ~/Library/LaunchAgents/ 并 `launchctl load`。周二至周六北京时间 11:30
     （美股收盘后的早晨）各触发一次。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.investment-assistant.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>-m</string>
        <string>investment_assistant.daily</string>
        <string>run</string>
        <string>--env-file</string>
        <string>__REPO__/.env</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>6</integer>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>INVESTMENT_ASSISTANT_RUNTIME_BASE</key>
        <string>__REPO__/.local/v3</string>
        <key>PI_CODING_AGENT_DIR</key>
        <string>__HOME__/.pi-ia</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/investment-assistant/logs/daily.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/investment-assistant/logs/daily.stderr.log</string>
</dict>
</plist>
